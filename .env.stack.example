# ==============================================================================
# INVERFIT DOCKER STACK - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.stack and customize credentials before running:
# docker compose -f compose.stack.yaml --env-file .env.stack up -d --build
# ==============================================================================

# --- API Application Configuration ---
APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database Name ---
MONGODB_DATABASE=inverfit_container

# --- MongoDB Root Admin Credentials (Container Initialization Only) ---
MONGO_INITDB_ROOT_USERNAME=inverfit_admin
MONGO_INITDB_ROOT_PASSWORD=change_this_mongo_root_password_in_production

# --- MongoDB Application User Credentials (Used by Go API) ---
MONGO_APP_USERNAME=inverfit_app
MONGO_APP_PASSWORD=change_this_mongo_app_password_in_production

# --- Go API MongoDB Connection URI ---
# Uses the application user, isolated database, and internal docker network host 'mongodb'
MONGODB_URI=mongodb://inverfit_app:change_this_mongo_app_password_in_production@mongodb:27017/inverfit_container?authSource=inverfit_container
