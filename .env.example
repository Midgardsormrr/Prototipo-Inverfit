# ==============================================================================
# INVERFIT FRONTEND — CONFIGURACIÓN DE ENTORNO (PLANTILLA)
# ==============================================================================
# Copie este archivo como '.env' para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# Modo Dual para fuentes de datos:
# 'api'  -> Conecta al backend Go + MongoDB (Docker Stack o Go local)
# 'mock' -> Funciona 100% autónomo en el navegador con localStorage (ideal para demo offline o Cloudflare Pages)
VITE_STUDENTS_DATA_SOURCE=api
VITE_SCHEDULE_DATA_SOURCE=api
VITE_PAYMENTS_DATA_SOURCE=api

# URL base del Backend Go:
# - Si se usa Docker Compose Stack (compose.stack.yaml): http://localhost:8081/api/v1
# - Si se ejecuta Go en nativo (go run ./cmd/api): http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8081/api/v1
