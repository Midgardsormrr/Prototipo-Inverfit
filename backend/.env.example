# ==============================================================================
# INVERFIT BACKEND — CONFIGURACIÓN DE VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# IMPORTANTE: Copie este archivo como '.env' para desarrollo local:
#   cp .env.example .env
# NUNCA incluya credenciales reales ni suba el archivo '.env' a Git.
# ==============================================================================

# Entorno de ejecución: development | test | production
APP_ENV=development

# Puerto del servidor HTTP
HTTP_PORT=8080

# Credenciales de autenticación para MongoDB local (Docker Compose)
MONGO_INITDB_ROOT_USERNAME=usuario_ejemplo
MONGO_INITDB_ROOT_PASSWORD=password_ejemplo_seguro

# Nombre de la base de datos de la aplicación
MONGODB_DATABASE=inverfit_dev

# Conexión a MongoDB (URI)
# Para MongoDB local con autenticación (Docker Compose):
#   mongodb://<usuario>:<password>@localhost:27017/inverfit_dev?authSource=admin
# Para MongoDB sin autenticación:
#   mongodb://localhost:27017
# Para MongoDB Atlas (Remoto):
#   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://usuario_ejemplo:password_ejemplo_seguro@localhost:27017/inverfit_dev?authSource=admin

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info
